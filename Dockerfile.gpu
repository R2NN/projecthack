ARG GPU_BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
FROM mcr.microsoft.com/powershell:7.5-ubuntu-24.04 AS powershell

FROM ${GPU_BASE_IMAGE}

ARG INSTALL_PIPELINE_DEPS=true
ARG PIPELINE_REQUIREMENTS=/app/pipeline/requirements-appliance-gpu.txt
ARG PRELOAD_RFDETR_TRAIN_WEIGHTS=false

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_COMPILE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:/usr/local/bin:/usr/bin:$PATH" \
    EASYOCR_MODULE_PATH=/opt/easyocr \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000 \
    ARTIFACTS_DIR=/app/artifacts \
    RUNTIME_DIR=/data/runtime \
    MODEL_PATH=/app/artifacts/models/rfdetr_small_price_tag_all_annotated_tiled1280_e8_checkpoint_best_total.pth \
    CATALOG_PATH=/app/artifacts/data/db_hack.csv \
    SAMPLE_CSV=/app/artifacts/data/sample.csv \
    SPECIAL_SYMBOL_TEMPLATE_DIR=/app/artifacts/special_symbol_templates/full_tags \
    SAVE_INPUT_VIDEO=false \
    SAVE_REVIEW_CROPS=true \
    CATALOG_MODE=assist \
    WORKER_MODE=local \
    INFERENCE_DEVICE=cuda \
    LENTA_PIPELINE_ROOT=/app/pipeline \
    LENTA_PIPELINE_SCRIPT=/app/pipeline/run_inference.ps1 \
    LENTA_POWERSHELL=pwsh \
    LENTA_PIPELINE_PYTHON=/opt/venv/bin/python \
    LENTA_TESSERACT_EXE=/usr/bin/tesseract \
    LENTA_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata \
    LENTA_RESULTS_DB=/data/runtime/lenta_results.sqlite \
    LENTA_WORKER_QUEUE_DB=/data/runtime/worker_queue.sqlite \
    LENTA_RETRAIN_CONFIG=/data/runtime/retrain_config.json \
    LENTA_UNCERTAIN_ROOT=/data/runtime/uncertain_predictions

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      ffmpeg \
      git \
      libicu74 \
      libgl1 \
      libglib2.0-0 \
      libgomp1 \
      liblttng-ust1 \
      libsm6 \
      libssl3 \
      libxext6 \
      libxrender1 \
      python3-venv \
      zlib1g \
      tesseract-ocr \
      tesseract-ocr-eng \
      tesseract-ocr-rus \
    && rm -rf /var/lib/apt/lists/*

COPY --from=powershell /opt/microsoft/powershell /opt/microsoft/powershell
RUN ln -sf /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh \
    && pwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'

WORKDIR /app

COPY pipeline/requirements*.txt /app/pipeline/
RUN /usr/bin/python -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir --no-compile --retries 10 --timeout 120 --upgrade pip \
    && if [ "$INSTALL_PIPELINE_DEPS" = "true" ]; then \
      /opt/venv/bin/python -m pip install --no-cache-dir --no-compile --prefer-binary --retries 10 --timeout 120 -r "$PIPELINE_REQUIREMENTS"; \
    else \
      /opt/venv/bin/python -m pip install --no-cache-dir --no-compile psutil; \
    fi

RUN if [ "$INSTALL_PIPELINE_DEPS" = "true" ]; then \
      mkdir -p "$EASYOCR_MODULE_PATH" \
      && for attempt in 1 2 3 4 5; do \
        /opt/venv/bin/python -c "import easyocr; easyocr.Reader(['ru', 'en'], gpu=False, verbose=False)" && break; \
        if [ "$attempt" = "5" ]; then \
          echo "EASYOCR_MODEL_PRELOAD_FAILED: cannot download EasyOCR rus+eng models during build" >&2; \
          exit 1; \
        fi; \
        sleep $((attempt * 10)); \
      done; \
    fi

RUN if [ "$INSTALL_PIPELINE_DEPS" = "true" ] && [ "$PRELOAD_RFDETR_TRAIN_WEIGHTS" = "true" ]; then \
      for attempt in 1 2 3 4 5; do \
        /opt/venv/bin/python -c "from rfdetr import RFDETRSmall; RFDETRSmall(num_classes=1, resolution=512)" && break; \
        if [ "$attempt" = "5" ]; then \
          echo "RFDETR_PRETRAIN_PRELOAD_FAILED: cannot download RF-DETR small pretrained weights during training image build" >&2; \
          exit 1; \
        fi; \
        sleep $((attempt * 10)); \
      done; \
    fi

COPY web /app/web
COPY pipeline /app/pipeline
COPY tools /app/tools
COPY configs /app/configs
COPY README.md .env.example /app/

RUN mkdir -p /app/artifacts /data/runtime

VOLUME ["/app/artifacts", "/data/runtime"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/api/ready' % os.environ.get('APP_PORT', '8000'), timeout=3).read()" || exit 1

CMD ["sh", "-c", "python /app/web/server.py --host ${APP_HOST:-0.0.0.0} --port ${APP_PORT:-8000}"]
