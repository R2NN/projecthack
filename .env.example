# Copy to .env and adjust for your machine.

# Web/API inside Docker.
APP_HOST=0.0.0.0
APP_PORT=8000
GPU_APP_PORT=8001
INSTALL_PIPELINE_DEPS=true
PIPELINE_REQUIREMENTS=/app/pipeline/requirements-appliance.txt
GPU_PIPELINE_REQUIREMENTS=/app/pipeline/requirements-appliance-gpu.txt
GPU_BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime

# Mounted data inside Docker. For local runs these can be relative paths.
RUNTIME_DIR=/data/runtime
ARTIFACTS_DIR=/app/artifacts
EASYOCR_MODULE_PATH=/opt/easyocr
MODEL_PATH=/app/artifacts/models/rfdetr_small_price_tag_all_annotated_tiled1280_e8_checkpoint_best_total.pth
CATALOG_PATH=/app/artifacts/data/db_hack.csv
SAMPLE_CSV=/app/artifacts/data/sample.csv
SPECIAL_SYMBOL_TEMPLATE_DIR=/app/artifacts/special_symbol_templates/full_tags

# Inference behavior.
SAVE_INPUT_VIDEO=false
SAVE_REVIEW_CROPS=true
CATALOG_MODE=assist
WORKER_MODE=local
INFERENCE_DEVICE=auto
MIN_FREE_GB=5

# Pipeline wiring.
LENTA_PIPELINE_ROOT=/app/pipeline
LENTA_PIPELINE_SCRIPT=/app/pipeline/run_inference.ps1
LENTA_POWERSHELL=pwsh
LENTA_PIPELINE_PYTHON=/opt/venv/bin/python
LENTA_TESSERACT_EXE=/usr/bin/tesseract
LENTA_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

# Optional host overrides used by docker-compose volumes.
HOST_ARTIFACTS_DIR=./artifacts
HOST_RUNTIME_DIR=./runtime

# On Windows you may point HOST_RUNTIME_DIR/RUNTIME_DIR to a larger drive.
