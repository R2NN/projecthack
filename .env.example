# Copy to .env and adjust for your machine.

# Heavy writable data. On Windows you can point this to another disk, for example:
# RUNTIME_DIR=A:\lenta_runtime
RUNTIME_DIR=./runtime
ARTIFACTS_DIR=./artifacts

# Web/API
WEB_PORT=5173
LENTA_WEB_RUNTIME_ROOT=./runtime
LENTA_RESULTS_DB=./runtime/lenta_results.sqlite
LENTA_WORKER_QUEUE_DB=./runtime/worker_queue.sqlite
LENTA_RETRAIN_CONFIG=./runtime/retrain_config.json
LENTA_UNCERTAIN_ROOT=./runtime/uncertain_predictions
LENTA_JOB_EXECUTION_MODE=local

# Pipeline
LENTA_PIPELINE_ROOT=./pipeline
LENTA_PIPELINE_SCRIPT=./pipeline/run_inference.ps1
LENTA_POWERSHELL=powershell.exe
LENTA_PIPELINE_PYTHON=python

# Tesseract. Set absolute paths if tesseract is not on PATH.
LENTA_TESSERACT_EXE=tesseract
LENTA_TESSDATA_DIR=

# Artifacts
LENTA_CATALOG_PATH=./artifacts/data/db_hack.csv
LENTA_DETECTOR_CHECKPOINT=./artifacts/models/rfdetr_small_price_tag_all_annotated_tiled1280_e8_checkpoint_best_total.pth

# Optional caches. Keep them off C: on small system disks.
PADDLE_CACHE_DIR=./runtime/cache/paddle
